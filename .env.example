#--------------------------------------------------------------------
# Salin menjadi .env lalu sesuaikan. File .env tidak boleh masuk git.
#--------------------------------------------------------------------

# development | production
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.appTimezone = 'Asia/Jakarta'
app.defaultLocale = 'id'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = crm_app
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

# Database khusus test (vendor/bin/phpunit)
database.tests.hostname = 127.0.0.1
database.tests.database = crm_app_test
database.tests.username = root
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.port = 3306

#--------------------------------------------------------------------
# PRODUKSI (HTTPS) — aktifkan di server produksi
#--------------------------------------------------------------------
# app.forceGlobalSecureRequests = true
# cookie.secure = true
# logger.threshold = 4
